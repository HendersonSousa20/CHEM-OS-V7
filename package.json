{
  "name": "chem-os",
  "version": "18.0.0",
  "private": true,
  "description": "CHEM.OS — 55 módulos de química no navegador: cálculos, simulações, laboratório virtual e guia de estudos. Funciona offline.",
  "scripts": {
    "dev": "node scripts/serve.js --root . --port 8080",
    "serve": "node scripts/serve.js --root dist --port 8080",
    "build": "node scripts/build.js",
    "lint": "eslint js",
    "lint:strict": "eslint -c eslint.strict.mjs js",
    "test": "node scripts/test.js",
    "test:dist": "node scripts/test.js --dist",
    "test:full": "node scripts/test.js --full",
    "verify": "npm run lint && npm test && npm run build && npm run test:dist",
    "css:inline": "node build-inline.js",
    "css:tailwind": "tailwindcss -c tailwind.config.js -i src/input.css -o css/tailwind.css --minify",
    "version:sync": "node scripts/sync-version.js",
    "vendor": "node scripts/vendor.js",
    "test:smoke": "node tests/smoke.js",
    "test:calc": "node tests/calc.js",
    "test:sim": "node tests/sim.js",
    "test:lab": "node tests/lab.js",
    "test:a11y": "node tests/a11y.js",
    "test:contrast": "node tests/contrast.js",
    "test:ux": "node tests/ux.js",
    "test:audit": "node tests/audit.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "jspdf": "^4.2.1",
    "tailwindcss": "3.4.17",
    "terser": "^5.51.2"
  },
  "engines": {
    "node": ">=20"
  }
}
